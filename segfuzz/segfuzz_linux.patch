@@ -0,0 +1,71 @@
+#ifndef __KSSB_H
+#define __KSSB_H
+
+#include <linux/kernel.h>
+#include <linux/llist.h>
+#include <linux/init.h>
+#include <linux/sched.h>
+
+// XXX: We really don't want to leave any of API calls as they may use
